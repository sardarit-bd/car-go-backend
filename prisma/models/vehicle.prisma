model Vehicle {
    id String @id @default(cuid())
    ownerId String
    name        String
    brand       String
    model       String
    description String
    class String
    seats       Int
    pricePerDay Decimal @db.Decimal(10, 2)
    //   owner User @relation(fields: [ownerId], references: [id])
    images         VehicleImage[]
    locations      VehicleLocation[]
    availabilities VehicleAvailability[]
    bookings       Booking[]
    deletedAt DateTime? 
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model VehicleImage {
    id String @id @default(cuid())
    vehicleId String
    imageUrl String
    vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleLocation {
    id String @id @default(cuid())
    vehicleId String
    country String
    city    String
    address String?
    vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleAvailability {
    id String @id @default(cuid())
    vehicleId String
    availableFrom DateTime
    availableTo   DateTime
    vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
    id                String        @id @default(cuid())
    vehicleId         String
    phoneNumber       String        // Added for the /check/:phoneNumber endpoint
    pickupDate        DateTime
    returnDate        DateTime
    pickupLocationId  String?       // Added for location tracking
    returnLocationId  String?       // Added for location tracking
    totalPrice        Decimal       @db.Decimal(10, 2) // Added for quote/payment
    status            BookingStatus @default(PENDING)
    
    createdAt         DateTime      @default(now())
    updatedAt         DateTime      @updatedAt
    deletedAt         DateTime?     // Added for soft delete

    vehicle           Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

    @@index([phoneNumber]) // Index for fast lookups by phone
    @@index([vehicleId, status, pickupDate, returnDate])
}