model CmsHeroFeature {
    id        String    @id @default(uuid())
    textPl    String    @default("")
    textEn    String    @default("")
    order     Int       @default(0)
    isActive  Boolean   @default(true)
    updatedAt DateTime  @updatedAt
    createdAt DateTime  @default(now())
    deletedAt DateTime?
}
