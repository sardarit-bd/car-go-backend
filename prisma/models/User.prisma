enum Role {
  ADMIN
  USER
  EMPLOYEE
}

model User {
  id               String    @id @default(uuid())
  firstName        String
  lastName         String
  email            String    @unique
  phone            String?
  password         String
  role             Role      @default(USER)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? // Consistent with your soft delete pattern
    reviews   Review[]

  // Add your relations here (e.g., bookings, vehicles)
}