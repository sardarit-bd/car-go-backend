model CmsSocialMedia {
    id        String    @id @default(uuid())
    platform  String // "Facebook", "Instagram", "Twitter", "LinkedIn"
    url       String
    isActive  Boolean   @default(true)
    order     Int       @default(0)
    updatedAt DateTime  @updatedAt
    createdAt DateTime  @default(now())
    deletedAt DateTime?
}
