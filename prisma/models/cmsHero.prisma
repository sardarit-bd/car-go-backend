model CmsHero {
    id         String    @id @default(uuid())
    taglinePl  String?
    taglineEn  String?
    titlePl    String    @default("")
    titleEn    String    @default("")
    subtitlePl String    @default("") @db.Text
    subtitleEn String    @default("") @db.Text
    updatedAt  DateTime  @updatedAt
    createdAt  DateTime  @default(now())
    deletedAt  DateTime?
}
