model Blog {
  id        String    @id @default(uuid())
  title     String
  slug      String    @unique
  content   String
  image     String?
  date      DateTime  @default(now())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}