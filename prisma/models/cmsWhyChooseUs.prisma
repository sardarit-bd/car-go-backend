model CmsWhyChooseUs {
    id         String    @id @default(uuid())
    subtitlePl String?
    subtitleEn String?
    titlePl    String    @default("")
    titleEn    String    @default("")
    mainImage  String?
    updatedAt  DateTime  @updatedAt
    createdAt  DateTime  @default(now())
    deletedAt  DateTime?
}
